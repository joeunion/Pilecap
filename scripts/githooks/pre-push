#!/usr/bin/env bash
# Pre-push: consult the verdict ledger first. A tree the full gate has already
# measured green passes in ~2s; anything else runs the full gate now.
#
# The ledger's key is the WORKING TREE's content address MINUS the paths a leg
# declares it derives, which on a clean tree with nothing declared is HEAD^{tree}
# — so a verdict earned before the commit vouches for the push after it, and a
# green run that republished a machine-dependent artefact still vouches for the
# tree it measured instead of banking nothing. The read is the same one the gate
# does: this hook sources the library below and calls `gate_measured_tree`, so
# there is one key and no second opinion about it. See scripts/gate_ledger.sh for
# the three properties, and for why an excluded path is one nothing measured
# reads back.
#
# AND BOTH SIDES OF EVERY COMPARISON HERE ARE THAT SAME READING. The
# ref being pushed is resolved through `gate_measured_tree_of`, never through a
# raw `<sha>^{tree}`: a raw tree and a measured tree agree exactly when nothing
# is declared, which made the two spellings look interchangeable on this
# template and made every push from a DECLARING product refuse its own tree as
# somebody else's. One arithmetic, on both sides, at every wall.
#
# THE DOCTRINE, IN ONE PARAGRAPH. One full gate per push to a FORGE: a tree that
# leaves this machine for somewhere it will be kept, shared or merged is measured
# here first, and that is the wall this file is. A VERIFIER BOX is not a forge —
# it is a throwaway machine whose ENTIRE JOB is to run the gate on the tree it is
# handed, so measuring that tree here first buys nothing and costs 30-70 minutes
# of this Mac before a byte can leave. A box destination is therefore EXEMPT from
# the measurement, by two conditions that must both hold: the caller declares
# `DJB_PUSH_DESTINATION=verifier-box`, AND the remote is the box wrapper's own
# throwaway probe (`…/.vouch-<pid>/probe.git`, absolute). The declaration alone
# opens nothing — that is what keeps the exemption from ever reaching `origin`,
# whoever exports the variable — and the exemption is from the MEASUREMENT only,
# never from the identity check: a tree that is not this checkout's is refused at
# a box destination exactly as it is anywhere else, because the box must measure
# what the checkout holds. Nothing is banked on the way out: the box's own run is
# the measurement, and its verdict is read on the box.
#
# AND THE HOOK SAYS, ON EVERY RUN, THAT IT RAN. One sentinel line —
# `pre-push: wall <verdict-word> <tree>` — precedes every terminal decision here,
# because a hook that did not run is INVISIBLE from the pushing side: a clone
# carries no `core.hooksPath` and its `.git/hooks` holds only samples, so the
# same `--dry-run` that demands a full gate from this checkout exits 0 in silence
# from a clone, and the tree travels unvouched. The caller reads the sentinel to
# tell "the wall let it through" from "there was no wall".
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# This is where the poison enters. `scripts/pm_push.sh` ends with
# `exec git -C "$PM_PUSH" push ...` and `$PM_PUSH` is a LINKED WORKTREE — which
# makes git EXPORT an absolute `GIT_DIR` into this hook's environment (a plain
# `git push` from a checkout exports none). An inherited `GIT_DIR` is absolute
# and it OVERRIDES `-C`, so every child of this hook that thought `-C <dir>`
# aimed it somewhere was aimed here instead: the pm_merge drive built its whole
# scenario in the real repository three pushes running.
#
# Unset AFTER the `cd` above, and measured to be free: discovery from a linked
# worktree's own directory returns the identical toplevel and the identical
# gitdir, because `.git` there is a file pointing at exactly the path git had
# exported. Nothing this hook or the gate does changes; the drives, the gate and
# `scripts/db.sh`'s checkout derivation simply stop inheriting an answer.
# The drives neutralise it a second time for themselves
# (`scripts/tests/drive_preamble.sh`) — they must be safe from any caller, not
# only from this one.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR \
    GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX

. scripts/gate_ledger.sh

# --- THE SENTINEL: THIS HOOK RAN ---------------------------------------------
#
# One line, on stdout, immediately before every terminal decision below. It is
# not narration: it is the only evidence a CALLER has that a wall was consulted
# at all. `git push --dry-run` exits 0 both when the hook let the tree through
# and when no hook exists to stop it, and the second case is what a verify clone
# is — measured on 2026-09-18: from the primary the dry-run demanded a
# full gate; from a `git clone` of it the identical command printed nothing and
# exited 0. `scripts/verifier_box.sh` reads this line and REFUSES when it is
# absent rather than shipping a tree no wall ever saw.
wall() { echo "pre-push: wall $1 ${2:-<unreadable>}"; }

# --- A VERIFIER-BOX DESTINATION, DECLARED AND PROVEN -------------------------
#
# BOTH CONDITIONS, AND NEITHER ALONE. git hands a pre-push hook `<remote name>
# <remote url>` as argv; the url is what says WHERE, and the variable is what
# says WHY. A declaration at any other remote is IGNORED and says so on its own
# line — which is what makes `DJB_PUSH_DESTINATION=verifier-box git push origin`
# a no-op rather than a hole. The probe's shape is the wrapper's own
# (`${VERIFIER_HOME}/.vouch-$$/probe.git`, and VERIFIER_HOME is absolute): a
# throwaway bare repository, made and removed around one `--dry-run`, which no
# `ssh://`, `git@` or named forge remote can ever be.
REMOTE_URL="${2:-}"
BOX_DESTINATION=0
GATE_REASON="this tree has no verdict"
if [ "${DJB_PUSH_DESTINATION:-}" = "verifier-box" ]; then
    case "$REMOTE_URL" in
    /*/.vouch-[0-9]*/probe.git) BOX_DESTINATION=1 ;;
    esac
    if [ "$BOX_DESTINATION" -eq 0 ]; then
        echo "pre-push: DJB_PUSH_DESTINATION=verifier-box ignored — the remote is not a verifier-box probe"
    fi
fi

# --- WHAT IS BEING PUSHED, READ FROM STDIN (R3's F4) -------------------------
#
# THE DEFECT THIS CLOSES. This hook used to consult the verdict for the local
# WORKING TREE and ignore stdin entirely — and git hands a pre-push hook the
# refs on stdin precisely because the working tree is not the subject. From a
# green-banked `main`, `git push <remote> <some-unmeasured-red-branch>` printed
# "already measured green … verdict honoured" and pushed bytes no gate had ever
# seen. `scripts/pm_push.sh` was safe for a reason this hook did not know about:
# its `pm-push` worktree is DETACHED to the SHA it pushes, so the two happened
# to agree. Agreement by coincidence is what this block replaces with a read.
#
# THE FORMAT, from `githooks(5)`: one line per ref,
# `<local ref> <local sha> <remote ref> <remote sha>`, and a DELETE is an
# all-zero local sha — nothing is being pushed, so there is nothing to vouch
# for and the line is skipped.
PUSHED_TREES=""
PUSHED_REFS=0
# THE DESTINATION REFS, kept for the CI-intent wall below: an intent vouches
# for a push whose EVERY ref is a train branch, and only this loop sees them.
PUSHED_TO=""
ZERO=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref _remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    case "$local_sha" in "$ZERO" | "") continue ;; esac
    PUSHED_REFS=$((PUSHED_REFS + 1))
    PUSHED_TO="${PUSHED_TO}${PUSHED_TO:+ }${remote_ref:-<none>}"
    # THE PUSHED TREE IS READ IN THE MEASURED FORM, NOT RAW. What this
    # loop collects is compared, below, against `$TREE` — which is
    # `gate_measured_tree`, the checkout's tree with every DECLARED derived
    # path subtracted. Reading the ref raw made the two sides of that compare
    # two different arithmetics: identical on a template that declares
    # nothing, and NEVER equal on a product that declares one, so the
    # product's own `main` was refused as a foreign tree on every push it
    # ever made. `gate_measured_tree_of` is the same subtraction asked of a
    # ref, sharing the one site with `gate_measured_tree`.
    #
    # `^{tree}` peels a tag as readily as a commit, so an annotated tag push
    # names the tree it points at rather than the tag object — and a ref this
    # repository cannot resolve makes the reader exit non-zero, which is the
    # same `UNRESOLVABLE` road it always was.
    #
    # `</dev/null` because THIS LOOP IS READING GIT'S REF LIST ON STDIN. The
    # reader shells out several times; a child that inherited this stdin and
    # read from it would eat refs the hook has not vouched for yet, and the
    # push would go through carrying them.
    t=$(gate_measured_tree_of "${local_sha}^{tree}" </dev/null 2>/dev/null) || t=""
    if [ -z "$t" ]; then
        echo "pre-push: cannot resolve a tree for the pushed ref ${local_ref} (${local_sha})." >&2
        echo "  A ref whose tree this repository cannot read is not a ref this hook can" >&2
        echo "  vouch for. Measuring." >&2
        PUSHED_TREES="UNRESOLVABLE"
        break
    fi
    case " $PUSHED_TREES " in
    *" $t "*) ;;
    *) PUSHED_TREES="${PUSHED_TREES}${PUSHED_TREES:+ }$t" ;;
    esac
done

TREE=$(gate_measured_tree || true)

# --- A CI INTENT, DECLARED — AND WHERE IT IS NEVER READ ----------------------
#
# `scripts/pm_push.sh --pr` pushes a `pm/*` train branch with NO local verdict:
# the pull request's CI run is the measurement, and `--ci-verdict` banks the
# row afterwards. It says so with `DJB_PUSH_INTENT=ci` on the one push it
# makes, after writing an INTENT row for the tree (`gate_ledger_intent_record`).
# The declaration is honoured for a push whose EVERY destination ref is
# `refs/heads/pm/*` and for nothing else — the refs are what git hands this
# hook, so this is the place that can tell a train branch from main. On a push
# naming any other ref (main above all) the declaration is IGNORED, and says
# so on its own line, BEFORE the ordinary lookup decides: an intent never
# vouches for main, and a verdict row for the tree still does exactly what it
# always did. An unknown value is ignored the same way — never silently.
INTENT_CI=0
if [ -n "${DJB_PUSH_INTENT:-}" ]; then
    if [ "${DJB_PUSH_INTENT}" != "ci" ]; then
        echo "pre-push: DJB_PUSH_INTENT='${DJB_PUSH_INTENT}' ignored — the one intent this hook reads is 'ci'"
    elif [ "$PUSHED_REFS" -eq 0 ]; then
        echo "pre-push: DJB_PUSH_INTENT=ci ignored — no ref is being pushed, so there is no train branch to vouch for"
    else
        INTENT_CI=1
        for r in $PUSHED_TO; do
            case "$r" in
            refs/heads/pm/?*) ;;
            *)
                INTENT_CI=0
                echo "pre-push: DJB_PUSH_INTENT=ci ignored — the push names ${r}, and an intent vouches for refs/heads/pm/* only, never for main; the ordinary lookup decides"
                break
                ;;
            esac
        done
    fi
fi

if [ "$PUSHED_REFS" -eq 0 ]; then
    # NO REFS IS NOT A PUSH. A hook invoked by hand, or a push that is entirely
    # deletions, has nothing whose tree could be consulted; the working tree is
    # then the only subject there is, and the line says so rather than implying
    # the stronger claim.
    echo "pre-push: no refs on stdin — consulting the verdict for the WORKING tree"
    if [ -n "$TREE" ] && gate_has_green "$TREE"; then
        wall honoured "$TREE"
        echo "pre-push: tree $TREE already measured green by a full gate run — verdict honoured"
        exit 0
    fi
    GATE_REASON="no verdict for the working tree"
else
    # EVERY pushed tree, not the first: a multi-ref push is vouched for only
    # when every tree in it has been measured. One green among several is one
    # green among several.
    unmeasured=""
    for t in $PUSHED_TREES; do
        if [ "$t" = "UNRESOLVABLE" ] || ! gate_has_green "$t"; then
            unmeasured="${unmeasured}${unmeasured:+ }$t"
        fi
    done
    if [ -z "$unmeasured" ]; then
        wall honoured "$TREE"
        echo "pre-push: every pushed tree ($PUSHED_TREES) is measured green by a full gate run — verdict honoured"
        exit 0
    fi
    # AND HERE IS WHERE A MEASUREMENT WOULD LIE. `./scripts/check.sh` measures
    # THIS CHECKOUT, and banks a verdict about THIS working tree. That is the
    # right thing to run only when the working tree IS the thing being pushed;
    # when it is not, running it would spend eight minutes proving something
    # about a tree nobody is pushing and then let the push through on it. So the
    # hook refuses, and names both trees — the remedy is to check out what you
    # are pushing (which is exactly what `scripts/pm_push.sh` does: a `pm-push`
    # worktree detached to the SHA), not to measure something else.
    #
    # AND A BOX DESTINATION IS EXEMPT FROM THE MEASUREMENT, NEVER FROM THIS. The
    # exemption below is reached only after this loop has agreed that every
    # unmeasured tree IS this checkout's tree: a verifier box exists to measure
    # what the checkout HOLDS, so a foreign tree at a box destination is the same
    # defect it is anywhere else and earns the same two-tree refusal.
    for t in $unmeasured; do
        if [ "$t" != "$TREE" ]; then
            wall refused "$TREE"
            echo "!! pre-push: REFUSED — the ref being pushed is not the tree in this checkout." >&2
            echo "   pushed tree(s) with no verdict: ${unmeasured}" >&2
            echo "   this checkout measures:          ${TREE:-<unreadable>}" >&2
            echo "   A full gate run here would measure THIS tree and bank a verdict about it," >&2
            echo "   which is not the thing being pushed. Push from a checkout of what you are" >&2
            echo "   pushing — scripts/pm_push.sh detaches a worktree to the SHA for exactly" >&2
            echo "   this reason — or run the gate there." >&2
            exit 1
        fi
    done
    GATE_REASON="the pushed tree is this checkout's tree and has no verdict"
fi

# --- THE CI-INTENT WALL -----------------------------------------------------
#
# REACHED ONLY HERE, for the verifier-box exemption's reason: everything above
# has honoured a verdict or refused a tree that is not this checkout's, so what
# is left is an UNMEASURED tree that IS this checkout's. For a train-branch
# push that declared `ci` (the block above), an intent row for exactly that
# tree, fresh, stands in for the measurement — the pull request's run is it —
# and NOTHING IS BANKED: the row is written by `--ci-verdict` from the run's
# record, never here. Without the row, the declaration buys nothing and the
# ordinary wall measures.
if [ "$INTENT_CI" -eq 1 ] && [ "$PUSHED_REFS" -gt 0 ]; then
    intent_line=""
    if intent_line=$(gate_ledger_intent_lookup "$TREE" </dev/null) && [ -n "$intent_line" ]; then
        wall ci-intent "$TREE"
        echo "pre-push: unmeasured tree ${TREE} leaves for a TRAIN BRANCH (${PUSHED_TO}) on a CI intent — the pull request's run is the measurement and --ci-verdict banks its row; no verdict is banked here"
        exit 0
    fi
    echo "pre-push: DJB_PUSH_INTENT=ci declared and no fresh intent row names tree ${TREE:-<unreadable>} — measuring"
fi

# --- THE VERIFIER-BOX EXEMPTION ----------------------------------------------
#
# REACHED ONLY HERE, which is the whole of its safety: every branch above has
# either honoured a verdict and exited, or refused a tree that is not this
# checkout's and exited. What is left is an UNMEASURED tree that IS this
# checkout's — the only population a box may carry — and for that population the
# Mac's gate is pure cost, because the box's own `--loop` is the measurement the
# verification is waiting for. NOTHING IS BANKED: no row is written here, and the
# box's verdict lives on the box where the verifier reads it.
if [ "$BOX_DESTINATION" -eq 1 ]; then
    wall box-exempt "$TREE"
    echo "pre-push: unmeasured tree ${TREE:-<unreadable>} leaves for a VERIFIER BOX — the box's own run is the measurement; no verdict is banked here"
    exit 0
fi

wall measuring "$TREE"
echo "pre-push: ${GATE_REASON} — running the full gate"
# The wall names itself. This is the doctrine's own case — one full gate
# per push — and it is the baseline every other caller is counted against.
#
# IT IS ALSO THE SANCTION. `scripts/check.sh` refuses an unsanctioned full run,
# and `push-wall` is the first of the three things that make one legal (THE FULL
# GATE IS SANCTIONED, in that file). Nothing is typed here and nothing needs to
# be: the wall is the case the valve exists to leave alone. Deleting this export
# would not merely lose a measurement any more — every push would refuse.
export DJB_GATE_CALLER=push-wall
exec ./scripts/check.sh
