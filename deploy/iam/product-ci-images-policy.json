{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ARegistryTokenTakesNoResource",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushAndReadTheTwoRepositoriesOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeImages",
        "ecr:DescribeRepositories"
      ],
      "Resource": [
        "arn:aws:ecr:${REGION}:${ACCOUNT_ID}:repository/${NAMESPACE}/djb-web",
        "arn:aws:ecr:${REGION}:${ACCOUNT_ID}:repository/${NAMESPACE}/djb-worker",
        "arn:aws:ecr:${REGION}:${ACCOUNT_ID}:repository/${NAMESPACE}/djb-frontend"
      ]
    }
  ]
}
