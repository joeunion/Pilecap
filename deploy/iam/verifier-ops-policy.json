{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunVerifierInstanceTaggedOnly",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/djb:role": [
            "verifier",
            "verifier-bake"
          ],
          "aws:RequestTag/djb:namespace": "${NAMESPACE}"
        },
        "Null": {
          "aws:RequestTag/djb:owner": "false",
          "aws:RequestTag/djb:expires": "false"
        }
      }
    },
    {
      "Sid": "RunVerifierSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:volume/*",
        "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:network-interface/*",
        "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:subnet/*"
      ]
    },
    {
      "Sid": "RunVerifierFromApprovedImagesOnly",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:${REGION}::image/*",
      "Condition": {
        "StringEquals": {
          "ec2:Owner": [
            "${ACCOUNT_ID}",
            "amazon"
          ]
        }
      }
    },
    {
      "Sid": "RunVerifierInTheVerifierGroupOnly",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/djb:role": "verifier",
          "ec2:ResourceTag/djb:namespace": "${NAMESPACE}"
        }
      }
    },
    {
      "Sid": "TagOnCreateOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:*/*",
        "arn:aws:ec2:${REGION}::image/*",
        "arn:aws:ec2:${REGION}::snapshot/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateImage"
          ]
        }
      }
    },
    {
      "Sid": "RetagAPooledVerifierBoxOnClaim",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/djb:role": "verifier",
          "ec2:ResourceTag/djb:namespace": "${NAMESPACE}",
          "ec2:ResourceTag/djb:for": "pool"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "djb:for"
          ]
        }
      }
    },
    {
      "Sid": "TerminateOnlyVerifierTaggedInstances",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/djb:role": [
            "verifier",
            "verifier-bake"
          ],
          "ec2:ResourceTag/djb:namespace": "${NAMESPACE}"
        }
      }
    },
    {
      "Sid": "CreateImageFromABakeBoxOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateImage",
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/djb:role": "verifier-bake",
          "ec2:ResourceTag/djb:namespace": "${NAMESPACE}"
        }
      }
    },
    {
      "Sid": "CreateImageArtifacts",
      "Effect": "Allow",
      "Action": "ec2:CreateImage",
      "Resource": [
        "arn:aws:ec2:${REGION}::image/*",
        "arn:aws:ec2:${REGION}::snapshot/*"
      ]
    },
    {
      "Sid": "PruneVerifierImagesOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DeregisterImage",
        "ec2:DeleteSnapshot"
      ],
      "Resource": [
        "arn:aws:ec2:${REGION}::image/*",
        "arn:aws:ec2:${REGION}::snapshot/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/djb:role": "verifier-image",
          "ec2:ResourceTag/djb:namespace": "${NAMESPACE}"
        }
      }
    },
    {
      "Sid": "ReadTheAccountAndItsPrices",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeImages",
        "ec2:DescribeSnapshots",
        "ec2:DescribeVolumes",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeSpotPriceHistory",
        "ec2:DescribeSpotInstanceRequests",
        "ec2:DescribeTags",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTheConsoleOfVerifierBoxesOnly",
      "Effect": "Allow",
      "Action": "ec2:GetConsoleOutput",
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/djb:role": [
            "verifier",
            "verifier-bake"
          ],
          "ec2:ResourceTag/djb:namespace": "${NAMESPACE}"
        }
      }
    },
    {
      "Sid": "ReadTheAmazonLinuxImageParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:${REGION}::parameter/aws/service/ami-amazon-linux-latest/*"
    },
    {
      "Sid": "ReadTheTwoQuotasTheCeilingIsBuiltOn",
      "Effect": "Allow",
      "Action": "servicequotas:GetServiceQuota",
      "Resource": [
        "arn:aws:servicequotas:${REGION}:${ACCOUNT_ID}:ec2/L-34B43A08",
        "arn:aws:servicequotas:${REGION}:${ACCOUNT_ID}:ec2/L-1216C47A"
      ]
    },
    {
      "Sid": "StartSessionToVerifierBoxesOnly",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/djb:role": [
            "verifier",
            "verifier-bake"
          ],
          "ssm:resourceTag/djb:namespace": "${NAMESPACE}"
        }
      }
    },
    {
      "Sid": "StartSessionNeedsItsDocumentsToo",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ssm:${REGION}::document/AWS-StartSSHSession",
        "arn:aws:ssm:${REGION}::document/AWS-StartInteractiveCommand",
        "arn:aws:ssm:${REGION}::document/SSM-SessionManagerRunShell"
      ]
    },
    {
      "Sid": "EndOnlyItsOwnSessions",
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": "arn:aws:ssm:*:*:session/${aws:username}-*"
    },
    {
      "Sid": "PassOnlyTheVerifierBoxRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/${NAMESPACE}-verifier-box",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyEveryWriteToAnEnvironmentBox",
      "Effect": "Deny",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/*",
      "Condition": {
        "Null": {
          "ec2:ResourceTag/Project": "false",
          "ec2:ResourceTag/djb:role": "true"
        }
      }
    }
  ]
}
