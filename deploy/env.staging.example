# staging.example.invalid — THE NAMES, NOT THE VALUES.
#
# This is a manifest: every variable the deployment needs, what it is for, and
# where its value comes from. **No secret is in this file and none ever will
# be.** `.env.example` at the repository root ships working development values
# on purpose, and that is exactly the file `config/settings/guards.py` refuses
# to start production on. This one ships names.
#
# HOW THE REAL FILE IS MADE — never by hand, never by copying this one:
#
#     deploy/provision.sh env-file  deploy/.env  staging     # generates every secret
#     deploy/provision.sh secrets-put   "$DJB_DEPLOY_NAMESPACE/staging/" deploy/.env
#     deploy/provision.sh secrets-fetch "$DJB_DEPLOY_NAMESPACE/staging/" deploy/.env   # on the box
#
# The generator is the only thing that writes a secret. Nobody types one, no
# value reaches a report or a shell history, and the expected number of
# human-entered secrets for this environment is zero (the secrets doctrine).
#
# WHICH VARIABLES GO WHERE. Two consumers read this file and they read it for
# different reasons:
#
#   * `docker compose` substitutes the ORGAN variables — the ones Postgres,
#     Zitadel, Temporal, ClickStack and Caddy are handed. Those must be in the
#     file on the box; compose has no vault client.
#   * `deploy/entrypoint.sh` materializes the APP variables into web's and
#     worker's own environment. On the `aws:` path those never touch disk.
#
# Nothing distinguishes them syntactically and nothing needs to: the sections
# below say which is which, and `deploy/assert_not_published.sh` reads the whole
# file before anything starts either way.

# --- This deployment's AWS namespace -----------------------------------------
# ONE SLUG, AND EVERY AWS COORDINATE IS COMPOSED FROM IT: the Secrets Manager
# prefix (`<ns>/<env>/env`), the two buckets (`<ns>-<env>-backups|media`), the
# two IAM roles (`<ns>-<env>-box`, `-backup-retention`), the EC2 Name/Project
# tags, the RDS identifier, the directory the tree lands in on the box
# (`deploy/ship.sh`) and the alert bundle's name
# (`deploy/observability/alerts/apply.py`).
#
# IT SHIPS EMPTY AND UNSET IS A REFUSAL, NEVER A FALLBACK — `deploy/dns.sh`'s
# zone-id grammar, for its reason one level down: a guessed zone id is a write
# into somebody else's DNS, and a guessed namespace is a write into somebody
# else's resources, or a DELETE of them. Every script that composes a
# coordinate exits 2 naming this variable rather than guessing, so an
# environment that has not been told its namespace stops loudly at its first
# command instead of quietly provisioning half of somebody else's account.
#
# THE VALUE IS THIS ENVIRONMENT'S, and it lives in the vault blob with every
# other value — never in this manifest, which ships names.
#
# NOT `DJB_PROJECT_NAME`: that is taken, and means the compose project a
# CHECKOUT derives from its own path (`provision.sh derived-project-name`).
DJB_DEPLOY_NAMESPACE=

# --- Where this deployment is, and how it is fronted -------------------------
# Caddy's three vhosts (deploy/Caddyfile) and, for CADDY_TLS, the ACME account
# email Let's Encrypt issues against. `internal` here means Caddy's own CA and
# is the laptop value; a real environment puts an address a human reads.
SITE_ADDRESS=staging.example.invalid
AUTH_ADDRESS=auth.staging.example.invalid
O11Y_ADDRESS=o11y.staging.example.invalid
CADDY_TLS=

# The wall in front of the sink's UI. The hash is bcrypt (`caddy hash-password`);
# `provision.sh env-file` generates the pair and prints the plaintext once.
O11Y_USER=observer
O11Y_PASSWORD_HASH=

# --- Where web and worker get their secrets ----------------------------------
# `aws:<prefix>` fetches from Secrets Manager at container start; `file:<path>`
# sources a file. See deploy/entrypoint.sh, and the runbook's secrets section
# for which one this environment is on today and why.
DJB_SECRETS_SOURCE=file:/deploy/.env

# --- Core (app) --------------------------------------------------------------
# Generated. production refuses to start on the published value, and
# assert_not_published.sh refuses it one step earlier still.
SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=staging.example.invalid
CSRF_TRUSTED_ORIGINS=https://staging.example.invalid
USE_I18N=0
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# --- Database ----------------------------------------------------------------
# TWO ROLES, AND THE DIFFERENCE IS THE POINT (deploy/grants.sql.py):
#
#   POSTGRES_USER / POSTGRES_PASSWORD   the RDS master. Owns the schema, runs
#                                       migrations, applies grants.sql, and is
#                                       what Temporal's auto-setup and Zitadel's
#                                       init connect as to create their own
#                                       databases. Never what the app connects
#                                       as.
#   DATABASE_USER / DATABASE_PASSWORD   the application's role. Holds SELECT,
#                                       INSERT, UPDATE, DELETE — minus UPDATE
#                                       and DELETE on every append-only table.
#
# One role for both would make the revoke meaningless: an owner can always
# re-grant to itself.
POSTGRES_USER=djb_master
POSTGRES_PASSWORD=
DATABASE_USER=djb_app
DATABASE_PASSWORD=
DATABASE_NAME=djb_staging
DATABASE_HOST=
DATABASE_PORT=5432
# --- The connection pool, and the budget it fits inside (ADR config-1) -------
# Read off pg_stat_activity on a real instance under load: 43
# connections held against <=4 active, flat across the whole ladder and
# unchanged 90 seconds after the load stopped. Under ASGI each sync_to_async
# thread owns a DatabaseWrapper whose connection is closed only at the end of a
# request that thread served, so with persistent connections the held count is
# "threads that have ever served a request", not "threads doing work". At
# concurrency 1 this deployment was already at the connection-slot wall.
#
# Django 5.2's native psycopg pool makes every request-end close a putconn.
# Held is then bounded by max_size by construction, the sockets stay warm (no
# fork plus TLS handshake per request, which matters because the convicted
# resource is a BURSTABLE instance's CPU), and an idle connection above
# min_size is dropped after DATABASE_POOL_MAX_IDLE so the residue goes away.
#
# THE ARITHMETIC, WITH THE NEIGHBOURS BOUNDED.
#
#     max_connections (db.t4g.micro)                          79
#   - Temporal, bounded: 4 roles x 4 + 4 roles x 2         <= 24
#   - Zitadel: 5 bounded + 2 its config cannot bound       <=  7
#   - RDS's own (rdsadmin 2, reserved/unnamed ~5)             ~7
#   - operator headroom (psql, backup, migration - AND the
#     oneoff door's <=2: the release acts ride this line)      8
#   ----------------------------------------------------------------
#   = the application's ceiling                               33
#
#   web max_size 20 + worker max_size 8                     =  28   <= 33
#
# WHAT CHANGED, AND WHY THE OLD NUMBER COULD NEVER HAVE HELD. This block used to
# subtract "Temporal 17 plus 3, Zitadel 3" as a budget CONSTANT the neighbours
# would go on drawing. It was not a constant; it was an at-rest reading of an
# unbounded thing. Temporal's auto-setup image runs frontend, history, matching
# and worker in ONE process and EACH ROLE builds its own SQL pool from the same
# config, so the image's defaults ceilinged at 4x20 + 4x10 = 120 slots against a
# max_connections of 79 - and RATIO-1 measured 41 held at rest after a reboot,
# which no single pool of 20 can produce. That inflation confounded a paid
# experiment (size B's knee was slot-gated, not CPU-gated) and refused a release
# act on a loaded box.
#
# The old sentence - "Temporal's own pool is its configuration to trim on some
# future Temporal touch" - is GONE, because this was that touch. The bounds are
# set in deploy/compose.yaml, on the organs themselves:
#
#   Temporal   SQL_MAX_CONNS 4 / SQL_MAX_IDLE_CONNS 4
#              SQL_VIS_MAX_CONNS 2 / SQL_VIS_MAX_IDLE_CONNS 2
#              (per SERVICE ROLE, hence x4 in the line above)
#   Zitadel    ZITADEL_DATABASE_POSTGRES_MAXOPENCONNS 5 / MAXIDLECONNS 2
#
# THOSE NAMES ARE DELIBERATELY NOT SLOTS IN THIS FILE. The ruled value is the
# same in every environment, so it lives once, as the compose default, rather
# than twice with a drift to keep in step - TEMPORAL_SQL_TLS is in this file
# because its value DIFFERS between a laptop and a box, and these do not. The
# override still exists by name for the recovery below: an operator writes
# TEMPORAL_SQL_MAX_CONNS into deploy/.env and recreates.
#
# ZITADEL'S +2 IS MEASURED AND NAMED. MAXOPENCONNS bounds Zitadel's main pool;
# its background job queue keeps a SECOND pool that no environment variable in
# v4.17.1 reaches (strings over the v4.17.1 binary returns MAXOPENCONNS,
# MAXIDLECONNS and the two lifetimes, and no queue knob at all). Driven both ways
# on the laptop deploy stack, recreating between runs:
#
#   image defaults 10/5   the zitadel database held 12 in the window after a
#                         recreate - exactly what RATIO-1 measured on the box
#   ruled 5/2             7 in the same window; 4 SETTLED, over four readings
#                         30 seconds apart
#
# The delta tracks the bound; the residue is the queue's. The line above
# therefore subtracts 7 - the observed CEILING, not the settled 4 - and the two
# unbounded slots come out of the operator headroom. A census reading Zitadel at
# 7 is AT its bound; above 7 is the stop-and-report.
#
# THE SHARP EDGE. Go's database/sql WAITS when a pool is exhausted, so a starved
# Temporal emits no error signature at all - only latency (workflow op latency,
# schedule-to-start lag). If those climb, the recovery is one step and env-only:
# TEMPORAL_SQL_MAX_CONNS=6 in deploy/.env and RECREATE, not restart.
#
# A pool is per PROCESS, and this file is read by every one of them, so the app's
# split is DERIVED from DJB_SERVICE_NAME (which deploy/compose.yaml sets per
# service) rather than set here: web 20, worker 8, oneoff 2. The oneoff door is
# the compose-run service that keeps a management command from reserving web's
# twenty slots; it is counted in the operator headroom line, not in the
# app's 28.
#
# THE TRIGGER TO REVISIT, rewritten against the bounds rather than against a
# number going stale: the census recipe reading ANY PRINCIPAL ABOVE ITS STATED
# BOUND, a NEW PROCESS CLASS joining the box, or REPLICAS - at which point
# replicas x processes x max_size is what stops fitting, and PgBouncer (rejected
# for the server-side-cursor cost it would impose on exports, search and the
# sweeps) is reconsidered.
#
# DATABASE_POOL_MAX_SIZE IS DELIBERATELY NOT HERE, for DJB_SERVICE_NAME's own
# reason further down: it is per-PROCESS, not per environment, and this file is
# read by both containers. Two things would go wrong if it were here. Empty:
# `deploy/provision.sh env-file` refuses an empty slot nothing claims to fill,
# and the entrypoint's `set -a; . file` would export the empty string into both
# processes anyway. A value: it would apply to BOTH, so web and worker would
# take the same number and the sum above would stop being the number that was
# reasoned about. A deployment that really does want to pin one process's size
# sets the variable on that container, where per-process values belong.
DATABASE_POOL_ENABLED=true
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_MAX_IDLE=300
# 0, and derived rather than read: with the pool on, Django refuses persistent
# connections outright. The value that belongs here if the pool is ever
# switched off is 60 — persistent connections, which is what the pool replaced;
# bare 0 with no pool is the rejected option, not the fallback.
DATABASE_CONN_MAX_AGE=0
# RDS speaks TLS, and PGSSLMODE is how this deployment insists on it. NOT
# DATABASE_URL: a URL wins over the parts (config/settings/base.py), so setting
# one here would make the release step's `-e DATABASE_USER -e DATABASE_PASSWORD`
# override — the one that runs `migrate` as the schema owner — silently do
# nothing. PGSSLMODE is libpq's own variable, read at connect time by every
# psycopg connection this process opens, and it composes with the parts instead
# of replacing them. DATABASE_URL stays empty for exactly that reason.
DATABASE_URL=
PGSSLMODE=require
# The same answer, spelled the way Zitadel's own settings spell it. Two
# variables because two programs read them; one value, and the runbook's
# release step is where they are checked to agree.
DATABASE_SSLMODE=require

# The two databases Temporal's auto-setup creates and owns on the same server,
# and the one Zitadel's init creates. Isolation by database, not by instance
# (ADR ident-1's reasoning, applied to the deployment).
TEMPORAL_DB_NAME=temporal
TEMPORAL_VISIBILITY_DB_NAME=temporal_visibility
# Temporal's half of the TLS answer every other database consumer already
# carries (DATABASE_SSLMODE / PGSSLMODE / ZITADEL_DATABASE_POSTGRES_*_SSL_MODE).
# RDS refuses an unencrypted connection, and Temporal's server defaults to one;
# see deploy/compose.yaml's `SQL_TLS` for the whole reason. `true` in every real
# environment; the laptop generator overrides it to `false`.
TEMPORAL_SQL_TLS=true
ZITADEL_DATABASE_NAME=zitadel
ZITADEL_ADMIN_EXISTING_DATABASE=postgres

# --- Redis -------------------------------------------------------------------
# The container on this box, by service name. Databases 0 and 1 keep the
# channel layer and the cache apart, exactly as they are kept apart on a laptop.
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# --- Temporal ----------------------------------------------------------------
# The auto-setup container, by service name. The task queue is NOT derived here:
# a deployment names it, because the derivation exists to keep two checkouts
# apart on one laptop and a deployment has no checkout.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=djb-staging

# --- Search ------------------------------------------------------------------
# The engine container on this box, by service name (deploy/compose.yaml), and
# the key BOTH sides read out of this one file — so there is one value and
# nothing to keep in step.
#
# WHY THE ENGINE IS DEPLOYED AT ALL rather than the deployment leaning on the
# Postgres fallback: degradation is a designed RUNTIME state (ADR search-2), not
# a deployment posture. A deployment that never had an engine is not degraded,
# it is unwired, and `apps/search`'s census row says NOT CONFIGURED — which the
# release wall refuses, correctly. With the engine present the row is honest and
# no rule had to be widened for it. Generated, like every other secret here.
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=

# --- The release wall's accepted fakes -----------------------------------------
# WHITESPACE-SEPARATED CENSUS KEYS THAT THIS DEPLOYMENT KNOWINGLY STANDS ON.
# `deploy/release.sh` expands each into `manage.py integrations --wall
# --accept-fake <key>`; every one is printed with its detail and its remedy on
# EVERY release, forever, and the census's other surfaces go on calling them
# fakes. Empty or unset is the full wall, and that is the default a product
# should keep.
#
# It is enumerated PER KEY against the live census, so it cannot become a mode:
# a key that is configured, absent, or not declared at all is refused (exit 1),
# and a NEW fake that arrives tomorrow refuses the release tomorrow.
#
# THE TWO BELOW ARE THE TEMPLATE'S OWN, AND THEY ARE MEANT TO BE DELETED.
# `FakeSmsChannel` and `FakePushChannel` hold the sms and push slots in a fresh
# clone and there is no gateway on this box to point them at — so without this
# line the template's own staging cannot perform its own runbook. **A product
# that registers a real transport DELETES the key from this line**, and the wall
# then refuses if the transport ever regresses. Leaving a key here after its
# integration became real is refused rather than ignored, so the deletion is not
# something anybody has to remember.
DJB_ACCEPTED_FAKES=comms-channel-push comms-channel-sms

# --- Encryption --------------------------------------------------------------
# Generated. Every tenant credential in apps/connections is encrypted with this;
# losing it is losing them, and publishing it is publishing them.
CONNECTIONS_ENCRYPTION_KEY=

# --- Email -------------------------------------------------------------------
# ADR comms-12, narrowing comms-11: Resend through anymail — no SES, no boto3,
# no external clock. THE PROVIDER IS `EMAIL_BACKEND` AND NOTHING ELSE, which is
# why the choice lands here and nowhere in `apps/comms`.
#
# `EMAIL_HOST`/`PORT`/`USER`/`PASSWORD` belong to the SMTP backend and are dead
# under an anymail one; they stay, empty, because a deployment that wants plain
# SMTP switches the backend line and fills them, and deleting them would make
# that a documentation lookup instead of a value.
#
# The API key is a Secrets Manager slot (`provision.sh`'s DEFERRED list names
# who fills it). The runbook's "Email mechanism" section carries the one-line
# table for every other anymail backend.
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
ANYMAIL_RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@staging.example.invalid
SERVER_EMAIL=no-reply@staging.example.invalid

# Every link in every email is built from this by a worker that has no request
# to ask. Scheme included, no trailing slash, and it must be the name a browser
# actually types: a link built from the wrong name is a link that resolves
# nowhere, and Zitadel's redirect URIs derive from it too.
PUBLIC_BASE_URL=https://staging.example.invalid

# --- Static and media --------------------------------------------------------
# Static is baked into the image and served by whitenoise. Media goes to S3 the
# moment a bucket is named, and naming it is the whole switch — a container's
# filesystem disappears at the next deploy.
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
# EMPTY, AND MEANT TO BE. The box has an instance role; boto3 finds it. A key
# pair in this file is a credential with no expiry sitting on a machine with a
# public IP.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_QUERYSTRING_AUTH=1
AWS_QUERYSTRING_EXPIRE=3600

# --- HTTPS and cookies -------------------------------------------------------
# BEHIND_PROXY=1 is legal here and only here-shaped: Caddy terminates TLS and
# sets X-Forwarded-Proto itself, overwriting anything a client claimed. That is
# the precondition config/settings/base.py states before Django is allowed to
# believe the header.
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
BEHIND_PROXY=1

# --- Observability (ADR obs-2) ----------------------------------------------
# The collector on this box, by service name; the collector is the only thing
# that talks to the sink. One sink, and a second one is refused.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
DJB_ENVIRONMENT=staging
# DJB_SERVICE_NAME IS DELIBERATELY NOT HERE. It is per-PROCESS, not per
# environment — `web` for one container and `worker` for the other — and
# deploy/compose.yaml sets it on each service. Putting it in this file would
# make the entrypoint's `set -a; . file` overwrite what compose just said, and
# the worker would file every log line and every span under `web`: half the
# platform invisible in the sink, looking exactly like the other half.
# DEFERRED, NOT GENERATED, and the difference is load-bearing. ClickStack's
# all-in-one image MINTS ITS OWN ingestion key during the first-run setup a human
# performs in the UI (runbook Part 9, step 53) and enforces it — so a generated
# value here is not a secret, it is a wrong answer the sink silently refuses
# while the whole stack looks healthy and every span is dropped after its retry
# budget. The key travels UI → env file, never the other way.
#
# It ships carrying `provision.sh`'s DEFERRED sentinel rather than empty, because
# deploy/compose.yaml reads it as `${CLICKSTACK_API_KEY:?…}` on two services and
# the stack has to be UP before the UI that mints the key exists. Exactly one
# slot in this deployment is allowed to do that, and deploy/entrypoint.sh refuses
# to start any container where a second one carries the sentinel.
CLICKSTACK_API_KEY=

# --- Alerting (ADR obs-2; docs/runbooks/alerts.md) ---------------------------
# WHERE AN ALERT GOES. One slot, two readers, and neither of them is a Claude
# session (a chat-assistant Slack tool carries interactive pings inside a
# session; production alerting rides a real incoming webhook and
# nothing else — an alert that needs a session alive is an alert that does not
# exist at 3am).
#
#   deploy/observability/alerts/apply.py   copies it into ClickStack at deploy
#                                          time, for the transition and /readyz
#                                          alerts ClickStack delivers.
#   the readyz-prober container            POSTs to it directly for the ONE alert
#                                          that cannot ride the sink: the sink
#                                          itself going deaf.
#
# EMPTY DISARMS THE PROBER'S HALF and the prober says so once per start rather
# than failing quietly. On a laptop this is the dummy receiver
# (`http://alerts-dummy:9099/hook`, deploy/observability/alerts/compose.sink.yaml);
# on a box it is the real incoming webhook.
# --- The observability sink's OPERATOR account -------------------------------
# THE CREDENTIAL'S HOME IS THE VAULT, and this is that home. It lived in
# `~/.clickstack-operator.pw` on the box — a dotfile beside a shell history,
# outside `assert_not_published`'s reach, outside the belt, and lost with the
# instance. ADR deploy-3a already says where an environment's secrets live: ONE
# JSON secret per environment, `$DJB_DEPLOY_NAMESPACE/<env>/env`. These two are slots in it
# like every other, so `secrets-fetch` puts them on a box and `secrets-put`
# takes them back, and nothing has to remember a filename.
#
# WHO READS THEM: `deploy/observability/alerts/apply.py` and `export.py`
# (`CLICKSTACK_ADMIN_EMAIL` / `CLICKSTACK_ADMIN_PASSWORD` are their REQUIRED_ENV
# — they refuse rather than default), and the operator performing runbook
# Part 9. DEFERRED, because the account does not exist until a human completes
# ClickStack's first-run setup at step 53 and chooses them there.
CLICKSTACK_ADMIN_EMAIL=
CLICKSTACK_ADMIN_PASSWORD=

SLACK_WEBHOOK_URL=

# The prober's own values (deploy/compose.yaml's `readyz-prober`). Judgment
# values, written down rather than tuned: 15 seconds between probes, three
# consecutive bad windows before either of its alerts opens. The arithmetic that
# follows from them is in docs/runbooks/alerts.md § Values and is RECORDED,
# never gated.
PROBE_INTERVAL_SECONDS=15
SINK_DEAF_WINDOWS=3
# 0 on a box: Caddy serves a Let's Encrypt certificate and a prober that skipped
# verification would not be probing the path a browser takes. The laptop
# generator sets 1, because Caddy signs with its own internal CA there.
PROBE_INSECURE=0
# EMPTY ON A BOX, AND THAT IS THE POINT: with it unset the prober resolves the
# site's public name itself, so DNS is in the tested path. The laptop generator
# fills it (`localhost:443:caddy:443`) because inside a container `localhost` is
# the container — see the header of deploy/observability/alerts/prober.sh.
PROBE_CONNECT_TO=

# --- API, rate limiting, retention ------------------------------------------
API_PAGE_SIZE=50
API_MAX_PAGE_SIZE=200
THROTTLE_AUTH_RATE=600/min
THROTTLE_TENANT_RATE=1200/min
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=600/min
IDEMPOTENCY_TTL_HOURS=24
EVENTS_OUTBOX_RETENTION_DAYS=30

# --- CORS --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=1

# --- Zitadel (the identity system, and the container) ------------------------
# EXTERNALSECURE=true and EXTERNALPORT=443 because TLS ends at Caddy and the
# issuer in the discovery document is built from these three. Getting them wrong
# is a login loop that reads as an application bug.
ZITADEL_MASTERKEY=
ZITADEL_EXTERNALDOMAIN=auth.staging.example.invalid
ZITADEL_EXTERNALPORT=443
ZITADEL_EXTERNALSECURE=true
ZITADEL_ISSUER=https://auth.staging.example.invalid
ZITADEL_DATABASE_USER=zitadel
ZITADEL_DATABASE_PASSWORD=
ZITADEL_ORG_NAME=Pilecap
ZITADEL_ADMIN_USERNAME=zitadel-admin@staging.example.invalid
ZITADEL_ADMIN_PASSWORD=
ZITADEL_MACHINE_USERNAME=djb-platform
ZITADEL_MACHINE_PAT_EXPIRES_AT=2099-01-01T00:00:00Z
# CLASSIC LOGIN, PINNED. Zitadel v4 routes OIDC `authorize` to Login V2 by
# default; Login V2 is a separate container this deployment does not ship, so the
# button on /accounts/login/ 404s at `/ui/v2/login/login?authRequest=…` and no
# browser login can complete as seeded. `false` keeps `authorize` on the
# classic UI the image already serves.
#
# IT TAKES AT INSTANCE CREATION ONLY. This is a `DefaultInstance` setting; the
# v4.17.1 image's own defaults.yaml says "once a feature is set on the instance
# (true or false), system level feature settings will be ignored until instance
# level features are reset". A fresh box gets it; an existing Zitadel is changed
# through the feature API instead.
#
# THE TRIGGER TO REVISIT: adopt Login V2 at **the first Zitadel upgrade that
# REMOVES classic login**. v4 deprecates it, so the clock runs; adopting means a
# second container, a second TLS name, and the Google IdP callback moving to
# `/idps/callback` — three changes for one button, and the product that wants
# Login V2's features is the one that should pay for them.
ZITADEL_LOGIN_V2_REQUIRED=false
# Minted once by the first-instance bootstrap into the zitadel_bootstrap volume.
# The runbook's identity step copies it out of the volume into this file; it is
# never in an image and never in this manifest.
ZITADEL_PAT=
ZITADEL_MANAGEMENT_TIMEOUT=10
ZITADEL_PROJECT_NAME=Pilecap
ZITADEL_BROWSER_APP_NAME=Web
ZITADEL_MCP_RESOURCE_NAME=MCP
ZITADEL_MCP_CLIENT_NAME=MCP Client
# DEBUG is off here, so `zitadel_seed` refuses to create a dev user at all —
# by design (guards.py names this as the stronger, upstream fence). The
# workforce login is the human door in a real environment.
ZITADEL_DEV_USER_EMAIL=
ZITADEL_DEV_USER_PASSWORD=
# Printed once by `manage.py zitadel_seed`; the runbook's identity step pastes
# them back here. A rotate is `zitadel_seed --rotate-web-secret`.
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_MCP_AUDIENCE=
ZITADEL_JWKS_CACHE_SECONDS=300

# --- Workforce sign-in (Google Workspace) ------------------------------------
# EMPTY DISABLES THE PROVIDER — not "allow any domain", the opposite. The
# redirect URI to register with Google is
# https://<SITE_ADDRESS>/accounts/google/login/callback/.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAINS=

# --- Tokens ------------------------------------------------------------------
ACCOUNTS_TOKEN_TOUCH_SECONDS=300
