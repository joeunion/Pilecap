# The edge. Three names, one process, certificates it gets by itself.
#
# Every address is an environment placeholder, so the SAME file serves the
# laptop proof (`localhost`, Caddy's internal CA) and a real environment
# (`staging.example.invalid`, Let's Encrypt). A `Caddyfile.staging` beside a
# `Caddyfile.local` is two files that drift, and the drift shows up as a
# redirect loop the day somebody edits one.
#
# `{$VAR}` is substituted by Caddy from its own environment at load time;
# deploy/compose.yaml is where those come from, and deploy/.env is where THOSE
# come from.

{
	# NO AUTOMATIC HTTP REDIRECTS. `.dev` is on the HSTS preload list, which
	# means a browser has never been willing to speak plain HTTP to these names
	# and never will be — so a :80 vhost redirecting to :443 is a listener
	# serving an audience that cannot exist.
	#
	# WHAT THIS ACTUALLY DOES TO PORT 80, measured rather than predicted. This
	# comment used to say :80 stays bound to answer the ACME HTTP-01 challenge,
	# because the environments contract names HTTP-01 as the issuance method.
	# That was wrong, measured on a real deployment: with the redirect server
	# off, Caddy has no reason left to bind :80 and does not — it listens on
	# :443 alone, and certificate validation completes over TLS-ALPN-01, which
	# is served on 443. So port 80 is closed or resets. There is nothing on it.
	#
	# That is the better posture and it arrived by itself, but it arrived
	# UNDECIDED: nothing here selects an issuance method, and a future Caddy that
	# preferred HTTP-01 would need :80 open and would fail closed instead. The
	# security group still opens 80 (deploy/provision.sh) for exactly that
	# reason — an issuance method is not a thing to discover a firewall rule
	# about at renewal time. Recorded for the ADR to settle rather than silently
	# changed here.
	auto_https disable_redirects

	# NO HTTP/3. Caddy's default advertises `alt-svc: h3=":443"`, and the
	# security group (deploy/provision.sh) opens tcp/443 only, so a browser that
	# took the offer stalled on udp/443 until it fell back. The edge offers what
	# the firewall carries; opening udp would reach only boxes provisioned after
	# it, this reaches every box on its next deploy.
	servers {
		protocols h1 h2
	}

	# Where Caddy's own logs go: stdout, structured, so `docker compose logs`
	# and the collector see the same lines. The app's logging is core.log's
	# business and is untouched by this.
	log {
		output stdout
		format json
	}
}

# --- The product -------------------------------------------------------------
# ONE site block for every surface — one stack, N hosts. The
# placeholder is every name the product answers at — the staff name first, then
# each other surface's — joined `a, b` so Caddy reads one address per name and
# gets one certificate per name (deploy/compose.yaml says where the list comes
# from). Which host is which surface is the app's question, asked of the Host
# header this block passes through untouched.
{$SITE_ADDRESS} {
	tls {$CADDY_TLS}

	encode zstd gzip

	# HSTS is set by Django too (SECURE_HSTS_SECONDS, .env), and it is set here
	# as well on purpose: a response Caddy generates itself — a 502 while `web`
	# is restarting, a request that never reached Django — must carry it too, or
	# the one response a browser sees during an incident is the one that
	# forgets to say "only ever HTTPS".
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	# THE ONE PATH SPLIT: every root the backend answers goes to `web`, and
	# everything else to the face — the dev proxy's twin, where `next dev`
	# hands `/api/v1/` to Django and draws the rest. The list is not a hand
	# list: `quality/tests/deploy/test_face.py` derives it from `config/urls.py`,
	# the ASGI mounts and STATIC_URL, and holds every rewrite in
	# `frontend/next.config.ts` inside it. `/` and `/welcome` are the face's
	# (`config/urls.py` mounts both as fallbacks a product with a face never reaches).
	@backend path /.well-known /.well-known/* /accounts /accounts/* /admin /admin/* /api /api/* /healthz /llms.txt /mcp /mcp/* /readyz /static /static/* /ws /ws/*

	# `web` is a container name on the compose network, resolved by Docker's
	# DNS. Caddy sets X-Forwarded-Proto itself and strips whatever a client
	# claimed, which is the precondition `.env`'s BEHIND_PROXY=1 states before
	# Django is allowed to believe the header.
	handle @backend {
		reverse_proxy web:8000 {
			# Sockets and the MCP stream are long-lived; the default read timeout
			# would cut them. Flush immediately so a server-sent stream is not
			# buffered into uselessness.
			flush_interval -1
		}
	}

	# The face: the Next standalone server, Host passed through untouched so
	# its server-side surface ask names the address the browser asked for.
	handle {
		reverse_proxy frontend:3000
	}
}

# --- Identity (ADR ident-1; the issuer in every discovery document) ----------
{$AUTH_ADDRESS} {
	tls {$CADDY_TLS}

	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	# h2c, and it is not optional: Zitadel serves its gRPC API and its REST
	# gateway on ONE port, and the gRPC half is HTTP/2 over cleartext behind
	# this proxy (`--tlsMode external` in compose.yaml says TLS ends here). A
	# plain `reverse_proxy zitadel:8080` speaks HTTP/1.1 and every gRPC call —
	# which is every management-API call our own services make — fails in a way
	# that looks like an authentication problem.
	reverse_proxy h2c://zitadel:8080
}

# --- The sink's UI (ADR obs-2) -----------------------------------------------
{$O11Y_ADDRESS} {
	tls {$CADDY_TLS}

	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	# Auth-walled, per the environments contract. ClickStack has its own login,
	# and this is a second wall in front of it rather than a replacement:
	# telemetry is the one surface that holds fragments of everything else, and
	# an unauthenticated /login page on the internet is a thing to have an
	# opinion about later rather than a thing to leave open now.
	#
	# The hash is bcrypt, generated by `provision.sh env-file`; the plaintext is
	# printed once and never stored.
	basic_auth {
		{$O11Y_USER} {$O11Y_PASSWORD_HASH}
	}

	reverse_proxy clickstack:8080
}
