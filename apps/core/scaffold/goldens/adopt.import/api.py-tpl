@router.post("/", response={201: WidgetOut}, url_name="widget-create")
def create_widget_route(request: TenantRequest, payload: WidgetIn) -> Status[WidgetOut]:
    """Create a widget

    Create a widget.
    """
    actor, tenant = acting(request)
    created = widget_create(
