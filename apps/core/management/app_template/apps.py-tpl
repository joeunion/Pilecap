"""How `{{ app_name }}` registers: discovery reads this file, never `config/`."""

from __future__ import annotations

from django.apps import AppConfig


class {{ camel_case_app_name }}Config(AppConfig):
    """The `{{ app_name }}` app."""

    name = "apps.{{ app_name }}"

    #: What this app may import (rule 7): the floor and each spine app it uses; no sideways import.
    depends_on: tuple[str, ...] = ("core", "accounts")
