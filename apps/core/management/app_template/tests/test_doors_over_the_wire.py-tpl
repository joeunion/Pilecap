"""The two doors of `{{ app_name }}`, answering one question the same way.

House rule 46: an app with a REST door beside an `mcp.py` owes a test that
drives BOTH over the wire and compares what they answered. Rule 17 diffs the
two REGISTRIES and proves a capability exists on both sides; it cannot see the
two doors DISAGREE about it, and both times they did in this tree the finding
came from a test of exactly this shape and from nothing else — one row rendered
under two key sets, and one consumer answering two credentials two ways.

`{{ app_name }}` has no door yet, so there is nothing to compare and this module
SKIPS. **The condition is derived from the app's own files, never from a flag**:
the day `api.py` or `mcp.py` lands beside it, this stops skipping and fails
saying what to write. A stub that went on passing after the doors arrived would
be worse than no stub at all.

THE MARKER SITS UNDER THE `if` ON PURPOSE. Rule 46 reads a module-level
`DOOR_PAIR` assignment as a CLAIM that the pair is answered, and it fires in
both directions — a claim for a pair the app does not own retires a debt that
was never taken on, and would red this app from birth. So the name is written
here for the always-on census to read in the source (`apps/conftest.py`,
`DJB_REACH_TOKENS`), and the claim rule 46 reads is the module-level line the
REAL parity test writes when it replaces this stub. The example to copy then is
`apps/example/tests/test_doors_over_the_wire.py`: both doors through the one
real ASGI application, `response.json()` against `result["structuredContent"]`,
key set exact and then whole.
"""

from __future__ import annotations

from pathlib import Path

import pytest

#: This app's label and its own package. The doors are read off the directory,
#: so nothing here has to be kept in step by hand.
LABEL = "{{ app_name }}"
APP_DIR = Path(__file__).resolve().parents[1]

#: The doors that exist today. Empty is the generated state.
DOORS = tuple(name for name in ("api.py", "mcp.py") if (APP_DIR / name).is_file())

NO_DOOR = f"{LABEL} exposes no door yet — the skip lifts when api.py or mcp.py exists"

STILL_A_STUB = (
    f"{LABEL} exposes a door now and this is still the generated stub. Drive both doors "
    "over the wire against the one real ASGI application and compare what they answered, "
    "key set exact and then whole; then claim the pair with a module-level "
    'DOOR_PAIR = ("rest", "mcp") (house rule 46). The worked example is '
    "apps/example/tests/test_doors_over_the_wire.py."
)

if not DOORS:
    pytest.skip(NO_DOOR, allow_module_level=True)

if len(DOORS) == 2:
    DOOR_PAIR = ("rest", "mcp")


def test_the_two_doors_answer_alike() -> None:
    """Replace this stub with the real comparison — it cannot pass as it stands."""
    pytest.fail(STILL_A_STUB)
