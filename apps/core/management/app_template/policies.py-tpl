"""Who may do what in `{{ app_name }}`. Policies are code; roles are data.

`core.authz.require(actor, "thing.update", thing)` finds this file by
discovery — it is never registered anywhere, and nothing above it holds a list.

    from typing import Any

    from apps.core.actor import Actor
    from apps.core.authz import Policy


    def owns_or_is_privileged(actor: Actor, obj: Any = None) -> bool:
        ...


    POLICIES: dict[str, Policy] = {
        "thing.create": can_create,
        "thing.update": owns_or_is_privileged,
    }

Keys are `<noun>.<verb>`; the predicate takes the acting `Actor` and the object
and returns a bool. Every scoped model's writes owe an entry here (house rule
13), and the reason this is code rather than a fourth role is that a role
cannot say "of their own" — it does not know which row you meant.
`apps/example/policies.py` is the worked example, including the interesting
case: approval asks a role question over the object's own branch, because
approving your own work is what an approval step exists to prevent.
"""

from __future__ import annotations
