# Every variable config/settings/base.py reads, with safe local defaults.
# scripts/setup.sh copies this to .env on a fresh clone. .env is never committed.

# --- The product's name ------------------------------------------------------
# THE ONE PLACE THIS PRODUCT IS NAMED. Every surface that shows a name or
# materialises one derives from it — the Zitadel project (`ZITADEL_PROJECT_NAME`
# below), the compose first-instance organisation and its service account, the
# devcontainer's display name — so a product sets its name once, here, and
# renames nothing else (ADR platform-1 in docs/product/architecture.md).
#
# Left at the template's own name on purpose: a clone that has not chosen a name
# yet should say it is the template rather than borrow somebody's product name.
#
# Two things deliberately do NOT follow it, and both are identity rather than
# display: `compose.yaml`'s `name: djangobootstrap` (containers and volumes key
# on it) and the Zitadel usernames below (accounts, already created).
PRODUCT_NAME=Pilecap

# --- Core -------------------------------------------------------------------
# This value is published in this repository and is therefore worth nothing.
# config.settings.production refuses to start with it — not merely with an empty
# one. Generate a real key for anything that is not a laptop:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=insecure-local-development-key-change-me-000000000000000000
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# English only by default. Off costs nothing and on costs a catalogue lookup per
# string to produce English; a product that needs translation turns it on as a
# recorded decision in its own architecture.md. This is NOT about time: USE_TZ
# is always on, everything is stored in UTC, and what a person is *shown* comes
# from Tenant.timezone / Tenant.locale — TIME_ZONE below is only the fallback.
USE_I18N=0
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# Apps this deployment leaves OUT, by label, comma-separated. Empty here on
# purpose: a development tree runs the whole template, worked example included.
# Only an app whose own AppConfig declares `optional = True` may be named —
# today that is `example`, which a product switches off once it has its own
# domain app rather than deleting the directory it may still want to read.
# Anything else (a non-optional app, a label that matches no app) is refused by
# name when settings are read, so the process does not start half-built.
#
# BEFORE YOU FLIP THIS IN PRODUCTION, run the absent-app suite — the same suite
# in the smaller world, which prints what it withheld and why:
#
#   DJB_DISABLED_APPS=example uv run pytest
#
# Until the collection was derived (apps/conftest.py, "the absent-app world")
# the suite could not even be COLLECTED with an app left out, so a configuration
# the template invites was one nobody had ever run. Read the census it prints:
# the derivation reads IMPORTS, so a test that reaches an absent app through a
# hardcoded URL or a string is invisible to it and FAILS rather than being
# withheld. Those failures are not noise — they are the absent app's real reach,
# and each one is either a test to rewrite against your own app or a coupling
# you did not know you had.
DJB_DISABLED_APPS=

# --- Database ---------------------------------------------------------------
# The compose Postgres. DATABASE_NAME is per-CHECKOUT and nothing ships pinned:
# `scripts/setup.sh` writes this checkout's name into your .env, and
# `source scripts/db.sh` exports the same one — djb_<branch>_<hash of the
# checkout's path>. A name already in the environment wins over both.
# DATABASE_URL, when set, wins over the DATABASE_* parts below.
DATABASE_URL=
DATABASE_NAME=
DATABASE_USER=djb
DATABASE_PASSWORD=djb
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
# --- The connection pool (ADR config-1) --------------------------------------
# Django 5.2's native psycopg pool, on by default. Every request-end close is a
# putconn: the socket goes back to a per-process pool instead of being kept by
# the thread that served the request, so server-side connections are bounded by
# max_size BY CONSTRUCTION and stay warm. It replaced persistent connections
# after a measurement found 43 held against <=4 active under ASGI, unreclaimed
# 90 seconds after the load stopped. The whole argument, the two rejected
# alternatives and the trigger to revisit are in config/settings/base.py,
# "Connection reuse", and in docs/product/architecture.md.
DATABASE_POOL_ENABLED=true
DATABASE_POOL_MIN_SIZE=2
# EMPTY MEANS DERIVED from DJB_SERVICE_NAME further down — web 20, worker 8,
# anything else 4 — because a pool is per PROCESS and its size is a property of
# what the process does. An explicit value here wins outright and applies to
# every process this file reaches, which is rarely what is wanted; a deployment
# pins one process's size on that container instead. `deploy/env.staging.example`
# leaves the name out entirely for that reason, and carries the
# neighbour-counted budget the two sizes have to fit inside.
DATABASE_POOL_MAX_SIZE=
# Seconds a request waits for a free connection before the pool refuses, and
# seconds an unused connection above min_size is kept before it is dropped.
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_MAX_IDLE=300
# 0 BECAUSE THE POOL IS ON, and Django refuses the other pair outright
# ("Pooling doesn't support persistent connections"). This line states what the
# assembly produces rather than steering it: with DATABASE_POOL_ENABLED=true the
# value is derived and this variable is not read at all. It IS read when the
# pool is switched off, and then the number that belongs here is 60 —
# persistent connections, which is what the pool replaced. Bare 0 with no pool
# is the option that was rejected on its merits (reconnect churn on a burstable
# instance's CPU, and it caps nothing).
DATABASE_CONN_MAX_AGE=0

# --- compose.yaml (the Postgres container itself) ---------------------------
POSTGRES_USER=djb
POSTGRES_PASSWORD=djb
POSTGRES_DB=djb_main

# --- Redis ------------------------------------------------------------------
# The channel layer (sockets) and the cache. One compose Redis; databases 0 and
# 1 keep the two apart.
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/1
#
# CACHE_KEY_PREFIX namespaces the cache per CHECKOUT — it defaults to this
# tree's database name, so two worktrees on the one Redis above never read each
# other's entries. Leave it empty to derive, exactly as TEMPORAL_TASK_QUEUE
# and TEMPORAL_MACHINERY_LIFETIME below do; set it only to share a cache on purpose.
CACHE_KEY_PREFIX=

# --- Temporal ---------------------------------------------------------------
# The dev server from compose.yaml: gRPC on 7233, the web UI on http://127.0.0.1:8233.
# TEMPORAL_TASK_QUEUE defaults to djb- plus DATABASE_NAME's suffix, so two
# worktrees' workers never steal each other's tasks. Set it only to override.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=
#
# TEMPORAL_MACHINERY_LIFETIME is how long the periodic machinery may outlive the
# worker that declared it (ADR platform-lifecycle-1). `process` — the default on
# a laptop and under pytest — creates NO Temporal Schedule objects and runs the
# same sweeps from the live worker; `deployment` — the default in production —
# creates durable Schedules that survive a restart. Leave it empty to take the
# settings module's own declaration, which is the honest answer nearly always.
TEMPORAL_MACHINERY_LIFETIME=

# --- Encryption -------------------------------------------------------------
# Fernet key for per-tenant connection credentials. This one is a published
# development value and is worth exactly nothing; production refuses to start
# without one of its own AND refuses this exact string:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTIONS_ENCRYPTION_KEY=X8S2D9HPCtxlLLMHRNYByWXXQf2JRMmaH16DIxD7vdo=

# --- Email ------------------------------------------------------------------
# Mailpit, from compose.yaml: SMTP on 1025, and every message it receives is
# readable at http://127.0.0.1:8025 and delivered to nobody. That is the point —
# a laptop that could email a real customer while somebody was testing an
# invitation is a bad afternoon, and the console backend shows you MIME source
# rather than the message a person will actually open.
#
# Product code never sends inline: apps.comms.services.send() writes the message
# row and starts DeliverMessageWorkflow, and the activity does the sending — so
# a mail host that blinks costs a retry instead of the write that asked for the
# email. (core.mail.send_mail is the same shape for the platform's own
# invitation mail; core.mail.send_now is the direct path, for tests and a shell.)
#
# THE PROVIDER IS THIS SETTING AND NOTHING ELSE. apps/comms sends through
# django.core.mail, so the transport is whatever EMAIL_BACKEND names, and
# Message.provider records it:
#
#   smtp        django.core.mail.backends.smtp.EmailBackend      (Mailpit here)
#   locmem      django.core.mail.backends.locmem.EmailBackend    (pytest)
#   anymail:*   anymail.backends.<esp>.EmailBackend              (production)
#
# django-anymail ships with the template (pyproject.toml) for that third row:
# SendGrid, Postmark, SES, Mailgun, Resend and the rest are Django email
# backends, so swapping ESP is this line plus that ESP's credentials — never a
# code path in apps/comms (ADR comms-12).
#
# THE CREDENTIALS ARE ENVIRONMENT VARIABLES, BY PREFIX. Anymail reads each ESP's
# key out of `settings.ANYMAIL` under that ESP's own name, and
# config/settings/base.py builds that dict from every `ANYMAIL_<KEY>` variable
# in the environment. So a deployment adds the one variable its provider wants
# and edits nothing:
#
#   ANYMAIL_RESEND_API_KEY=...        with EMAIL_BACKEND=anymail.backends.resend.EmailBackend
#   ANYMAIL_MAILGUN_API_KEY=...       with anymail.backends.mailgun.EmailBackend
#   ANYMAIL_POSTMARK_SERVER_TOKEN=... with anymail.backends.postmark.EmailBackend
#
# The template proves the mechanism against Resend and names no ESP anywhere in
# config/ or apps/. Only the SENDING credential goes here. A provider's webhook
# SIGNING secret does not: inbound signatures are checked per tenant against
# apps/connections' `Connection.webhook_secret`, encrypted on the row, because a
# deployment-wide signing secret would be every tenant's provider sharing one.
ANYMAIL_RESEND_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
# A mail host that accepts the connection and then never answers must not hold
# an activity open until its own timeout fires.
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@localhost
SERVER_EMAIL=no-reply@localhost

# Where this deployment is reachable from the outside — scheme included, no
# trailing slash. Every link a person will click in an email is built from this,
# because the worker that renders it has no request to ask. Set it to the real
# hostname in any deployment; an invitation pointing at 127.0.0.1 is a bug
# nobody notices until a customer reports it.
#
# THE :8000 BELOW IS AN OVERRIDE, NOT A STATEMENT ABOUT WHERE THIS CHECKOUT
# SERVES. `serve.sh` DERIVES its port from the checkout, so on a laptop
# this value and the running server usually disagree — and `serve.sh` says so
# on startup rather than letting a login bounce off a dead port. Two honest
# ways to agree: set this to the port `./scripts/serve.sh --print-port` reports,
# or pin `PORT=8000` and keep the line as written. A real deployment sets it to
# the real hostname and the question does not arise.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Where the PRODUCT lives, as opposed to where this deployment answers. EMPTY
# means "the same place", which is what a clone with no front end of its own
# wants: a completed sign-in then lands on the shipped placeholder landing page
# at `/welcome/`, and nothing has to be configured for the first minute to work.
#
# Set it the day the product grows a front end somewhere else — a separate
# Next.js deployment, a static host — and the same completed sign-in lands there
# instead, because `LOGIN_REDIRECT_URL` is derived from this value rather than
# typed. Scheme included, no trailing slash.
#
# It is a SEPARATE variable from `PUBLIC_BASE_URL` on purpose: invitation links
# and webhook callbacks have to reach THIS process, and pointing them at a
# front end would break both the day somebody set this.
PRODUCT_BASE_URL=

# The ONE colour the sign-in chain declares. It is read into the entrance
# templates' token block, and the hosted identity platform's own screen will be
# branded from the same value, so the page before the hop and the page after it
# match without anybody keeping two settings in step.
#
# A CSS hex colour — `#rgb`, `#rrggbb`, or with an alpha pair. Anything else
# falls back to the shipped neutral rather than half-styling the page.
#
# The default is a restrained near-neutral, not a placeholder that shouts.
# THIS IS THE LINE TO CHANGE FIRST when a product wants to look like itself:
# one value, and the whole entrance chain plus the hosted step follow it.
BRAND_ACCENT=#3f4a5a

# --- Static and media -------------------------------------------------------
# Static is served by the web process itself (whitenoise), so there is no CDN
# origin or nginx sidecar for the admin and /api/v1/docs. Production collects into
# STATIC_ROOT at image build time with hashed filenames; a laptop serves
# straight from the finders and needs no collectstatic at all.
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=media

# --- Object storage ---------------------------------------------------------
# Uploaded files. Empty bucket name = the local filesystem, which is the right
# default for a laptop and the wrong one for a container. **Naming a bucket is
# the whole switch to S3** — there is deliberately no separate USE_S3 flag,
# because a deployment that set one and forgot the other would write uploads
# onto a filesystem that disappears at the next deploy.
#
# Leave the two credentials empty in any real deployment: an instance role or a
# workload identity is how this should authenticate, and boto3 finds those by
# itself. They exist for a laptop pointing at MinIO.
#
# Keys are built by apps/files/storage.py::version_key — `t/<tenant pk>/f/<file
# pk>/v/<n>`, primary keys and a version ordinal and nothing renamable.
# (Every app stores through this seam; the old core key builder was deleted
# once its last caller was gone, and rule 48 fences the seam.)
#
# EMPTY HERE ON PURPOSE, AND FILLED FOR YOU BY SETUP. The name is derived per
# CHECKOUT — the DATABASE_NAME rule, for objects: `djb-<this directory>-<8 hex
# of the SHA-256 of the checkout's absolute path>`, plus a `-gwN` suffix per
# pytest-xdist worker at test time — so two worktrees sharing one compose MinIO
# never write into one bucket, and one gate's prefix delete can never take
# another's objects away. `scripts/setup.sh` asks the seam for that name
# (`manage.py ensure_bucket`, which also creates the bucket if it is absent) and
# writes it into YOUR .env; this file ships empty because the right value is a
# fact about a directory that does not exist yet.
#
# A NAME ALREADY HERE WINS and nothing re-derives over it — the same escape
# DATABASE_NAME has, and what a deployment pointing at a real S3 bucket relies
# on. `manage.py ensure_bucket` prints whichever name won.
#
# What an empty name MEANS, since three other things read it: uploads stay on
# the local filesystem (STORAGES, above), /readyz carries no `storage` member
# (apps/core/health.py — a report with no member IS the signal that no bucket is
# configured), and apps/files refuses rather than inventing a bucket.
AWS_STORAGE_BUCKET_NAME=
# MinIO ignores the region and boto3 wants one named; us-east-1 is MinIO's own
# default and means nothing here. A real deployment names its bucket's region.
AWS_S3_REGION_NAME=us-east-1
# The compose MinIO's S3 API. Points at MinIO already so that naming a bucket
# is the only step left; empty in any deployment talking to real AWS S3.
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_S3_CUSTOM_DOMAIN=
# The compose MinIO's root credentials, published in this repository and
# therefore worth nothing. They are inert until a bucket is named above.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- compose.yaml (the MinIO container itself) -------------------------------
# The same published pair, spelled the way the container reads it — the two
# names exist because one configures the server and the other configures the
# client, and a deployment sets only the client half (against real S3). No
# settings module reads MINIO_ROOT_*; config/settings/guards.py's boundary
# comment records that, and records that nothing therefore refuses them.
#
# The S3 API is on 127.0.0.1:9000 and the operator console on 127.0.0.1:9001.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Objects are private and read through a signed URL that expires. A public-read
# bucket makes every key a URL anyone who guesses it can fetch, which is the
# same as having no tenancy on files at all.
#
# THESE TWO GOVERN `STORAGES` AND NOTHING ELSE — django-storages' own default
# backend, which `apps/exports` used before its archive moved onto the files
# seam. **`apps/files` does not read them**: it signs with its own pair below,
# and an operator who tuned `AWS_QUERYSTRING_EXPIRE` expecting document links to
# live longer changed nothing at all (measured: the env at 3600 while the
# minted URLs carried 900 and 300).
AWS_QUERYSTRING_AUTH=1
AWS_QUERYSTRING_EXPIRE=3600

# --- Files: how long a presigned URL lives (ADR files-2) ---------------------
# The two knobs that DO reach the links `apps/files` hands out, in seconds.
#
# The download link is short because it is a bearer credential with nobody's name
# on it and no way to revoke it: five minutes, re-issued on demand, and each
# issuance recorded against the version it was for. Lengthening it lengthens the
# window a leaked link is worth something, and coarsens the only approximation of
# "who fetched these bytes" this design can offer — the fetch goes to the object
# store, not to us.
FILES_DOWNLOAD_URL_TTL=300
# The upload link is longer because a large file on a slow connection has to get
# started, and it can afford to be: whatever lands there is streamed and digested
# by the platform before any row calls it stored, and the signature carries
# `If-None-Match: *`, so replaying it cannot overwrite finalized bytes.
FILES_UPLOAD_URL_TTL=900

# --- Search (Meilisearch, and the container itself) --------------------------
# The search engine from compose.yaml, on http://127.0.0.1:7700 (ADR search-2).
# Postgres full-text is the designed degradation behind it, which is why
# Meilisearch is deliberately NOT a /readyz dependency: the engine being down
# makes search slower and plainer, never dead, and a readiness member would
# turn that into a self-inflicted outage. See apps/core/health.py's checks().
#
# The index prefix is derived per CHECKOUT, like DATABASE_NAME and the bucket
# above, so two worktrees never write into one index. There is no variable for
# it here on purpose — a pinned prefix would be exactly the collision the
# derivation exists to prevent.
#
# MEILI_URL and MEILI_MASTER_KEY are read HERE INTO SETTINGS and used in
# `apps/search/engine.py`, and nowhere else — house rule 33's fence, ADR
# search-2. **`config/settings/base.py` is what reads them** — the engine used
# to read `os.environ` itself, which put the one external service in this
# product outside `config/settings/test.py`'s pin and let a developer's `.env`
# configure the gate. The container reads the key too;
# the URL is the address the engine module will dial, and the value is live for
# a laptop's browser and for anything curling the engine.
#
# **A missing MEILI_MASTER_KEY is not a quiet default — it is a 401.** The
# compose container runs WITH a key, so a caller that sends none is refused
# `invalid_api_key`, which the search circuit treats exactly as an unreachable
# index (degraded, answered from Postgres) and the reconcile treats exactly as
# an outage (a pass that completes with a finding). Both are the world saying
# no. Leaving this line out of a `.env` is how that happened once.
MEILI_URL=http://127.0.0.1:7700
# Published in this repository and therefore worth nothing; production injects a
# real one from Secrets Manager. Set, not empty, even on a laptop: with a key
# the engine requires it on every request, so dev and prod are the same shape.
MEILI_MASTER_KEY=djb-local-development-meili-master-key
# `development` enables the bundled search preview on 7700 and relaxes nothing
# about the key above. A deployment runs `production`.
MEILI_ENV=development

# --- HTTPS and cookies ------------------------------------------------------
# These are the production defaults; config.settings.local turns them off so a
# plain-HTTP runserver works.
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

# Set to 1 ONLY when a load balancer, ingress or reverse proxy terminates TLS in
# front of this process AND strips any client-supplied X-Forwarded-Proto. That
# is what makes SECURE_PROXY_SSL_HEADER safe; without such a proxy, any client
# could claim its plain-HTTP request arrived over TLS and every HTTPS check
# above would believe it. Off by default, because "no proxy" is the safe guess.
BEHIND_PROXY=0

# --- Observability ----------------------------------------------------------
# One sink: OpenTelemetry over OTLP to ClickStack. Logs, traces and metrics from
# the web process, the worker and every door go here and nowhere else.
#
# EMPTY BY DEFAULT, and that is the everyday setting. With no endpoint the app
# still traces — so trace_id and span_id are on every log line where you are
# actually reading them — and simply does not export: no network, no library
# patching, no second stack to run. Turn it on when you want the traces:
#
#   docker compose --profile observability up -d
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318   # the local collector
#
# The HyperDX UI is then on http://127.0.0.1:8080. Production points this at
# ClickStack's real endpoint; nothing else about the app changes.
OTEL_EXPORTER_OTLP_ENDPOINT=

# What this process is called in the sink. scripts/worker.sh sets `worker`; the
# web process is `web`. A product with more processes names them here.
DJB_SERVICE_NAME=web

# The deployment this process belongs to, as an OTel resource attribute.
DJB_ENVIRONMENT=local

# The ingestion key the collector presents to ClickStack. Published here and
# therefore worth nothing; it never leaves the compose network on a laptop.
CLICKSTACK_API_KEY=local-development-ingestion-key

# --- API --------------------------------------------------------------------
# Mounted at /api/v1/. The page size a list returns when a client asks for
# nothing, and the ceiling on ?page_size= — without a ceiling that parameter is
# a slower way to ask for the whole table.
API_PAGE_SIZE=50
API_MAX_PAGE_SIZE=200

# --- Rate limiting ----------------------------------------------------------
# Per credential and per tenant, counted in the shared Redis cache. Loose enough
# that only a loop hits them: a limit people disable in production is not a
# limit. Format is <count>/<period>, period one of s|m|h|d.
THROTTLE_AUTH_RATE=600/min
THROTTLE_TENANT_RATE=1200/min
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=600/min

# How long an Idempotency-Key response stays replayable.
IDEMPOTENCY_TTL_HOURS=24

# How long a dispatched outbox row is kept before the daily housekeeping
# workflow removes it. The Event rows themselves are never purged by this.
EVENTS_OUTBOX_RETENTION_DAYS=30

# --- CORS -------------------------------------------------------------------
# Only needed for a browser front end on another origin; the machine door is
# bearer tokens and needs neither CORS nor CSRF. An explicit list, comma
# separated, scheme included — there is deliberately no allow-all switch,
# because with credentials that is the same as no origin policy.
#   CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=1

# --- Zitadel (the identity system, and the container itself) -----------------
# Zitadel is THE identity system (architecture.md, ADR ident-1): browser login,
# the MCP door's authorization server, workforce federation and every customer's
# IdP. compose.yaml runs it on http://localhost:8081 against a dedicated
# `zitadel` database on the same Postgres as everything else; the console is on
# /ui/console. Identity CONFIGURATION is written through our services, never in
# that console (ident-2) — the console is a window, not a door.
#
# Everything below is a laptop default published in this repository and
# therefore worth nothing. A real deployment generates its own, and puts them in
# a secrets manager rather than a file (architecture.md, "Secrets").
#
# Exactly 32 bytes, or Zitadel refuses to start. It encrypts every secret
# Zitadel stores at rest, so changing it on an existing database makes that
# database unreadable. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32)[:32])"
ZITADEL_MASTERKEY=djb-local-development-masterkey!
# Where Zitadel believes it is reachable — the issuer in the discovery document,
# every redirect and every token audience are built from these. 8081 rather than
# Zitadel's own 8080, which the ClickStack UI already publishes.
ZITADEL_EXTERNALDOMAIN=localhost
ZITADEL_EXTERNALPORT=8081
ZITADEL_EXTERNALSECURE=false
# The same three, spelled the way an OIDC client needs them. This is what
# /.well-known/openid-configuration reports as `issuer`.
ZITADEL_ISSUER=http://localhost:8081
# The role and database Zitadel owns on the compose Postgres. Both are created
# on first start by Zitadel's own `init` step, using the POSTGRES_USER /
# POSTGRES_PASSWORD superuser above — that is the init mechanism, and it is why
# `docker compose up -d zitadel` works without setup.sh having run.
ZITADEL_DATABASE_USER=zitadel
ZITADEL_DATABASE_PASSWORD=zitadel
# The first instance, created once on an empty database: an organisation, a
# human who can sign in to the console, and the machine user our services
# authenticate the management API as.
# The org's display name follows PRODUCT_NAME when this is empty; set it only
# when the organisation has to be called something other than the product.
ZITADEL_ORG_NAME=
# A LOGIN, not a display name, so it does not follow PRODUCT_NAME: the first
# instance is created once and renaming this account is a migration.
ZITADEL_ADMIN_USERNAME=zitadel-admin@djangobootstrap.localhost
ZITADEL_ADMIN_PASSWORD=Password1!
ZITADEL_MACHINE_USERNAME=djb-platform
ZITADEL_MACHINE_PAT_EXPIRES_AT=2099-01-01T00:00:00Z
# The machine user's personal access token. **Deliberately empty here.** Zitadel
# mints it once, into a named docker volume; ./scripts/setup.sh copies it into
# your .env, which is gitignored. A PAT in .env.example would be a credential in
# the repository — and the one thing this file may never contain.
ZITADEL_PAT=
# How long one management-API call may take, in seconds. A hung management call
# is a worker thread that never comes back; the retrying is Temporal's, at the
# activity's call site, not this client's.
ZITADEL_MANAGEMENT_TIMEOUT=10
# What `manage.py zitadel_seed` names the objects it makes, and what
# `manage.py zitadel_audit` looks for when it compares. Settings rather than
# constants so a second deployment (a staging tree beside a development one) can
# share an instance without colliding. Empty here: the default is PRODUCT_NAME,
# so naming the product names its project. **Changing it after a seed does not
# rename anything** — `zitadel_seed` finds-or-creates by name, so a new value on
# an already-seeded instance makes a SECOND project with fresh client ids while
# ZITADEL_CLIENT_ID below still points at the old one. An already-seeded
# deployment pins its old name here until somebody renames the project for real.
ZITADEL_PROJECT_NAME=
ZITADEL_BROWSER_APP_NAME=Web
ZITADEL_MCP_RESOURCE_NAME=MCP
ZITADEL_MCP_CLIENT_NAME=MCP Client
# The person `./scripts/setup.sh` leaves you able to sign in as. A laptop
# default published in this repository, and therefore worth nothing.
ZITADEL_DEV_USER_EMAIL=dev@djangobootstrap.localhost
ZITADEL_DEV_USER_PASSWORD=Password1!
# --- this deployment's sign-in posture (ADR ident-8) -------------------------
# Whether a stranger may register themselves an account on the hosted login
# page. Off, because `architecture.md` §H rejected open signup and invitations
# are the way in; `manage.py zitadel_seed` applies it to the live instance on
# every setup, and `manage.py zitadel_audit` says so when the console disagrees.
ZITADEL_ALLOW_SELF_REGISTRATION=false
# Whether a stranger may create an ORGANISATION here, at
# /ui/login/register/org. A different door from the one above and closing that
# one does not close this one: the org-registration form creates an org and its
# first administrator in one POST.
ZITADEL_ALLOW_PUBLIC_ORG_REGISTRATION=false
# THE SAME DOOR, SPELLED THE IMAGE'S WAY, and this is the one line here that is
# not simply the negation of the one above.
#
# `manage.py zitadel_seed` reads ZITADEL_ALLOW_PUBLIC_ORG_REGISTRATION and is
# THE MECHANISM: it writes the live instance on every setup and every deploy,
# and it is what actually closes or opens the door. This variable feeds
# compose's `ZITADEL_DEFAULTINSTANCE_RESTRICTIONS_DISALLOWPUBLICORGREGISTRATION`,
# which Zitadel applies ONLY WHEN AN INSTANCE IS CREATED — the belt, for the
# seconds between a fresh instance existing and the seed running against it.
# Two variables because the image's key is spelled DISALLOW and compose has no
# `!` in `${…:-…}`; one variable with an inverted meaning would be a line whose
# `false` means "closed" three lines below a line whose `false` means "open".
#
# SO IT IS THE OTHER POLARITY: `true` closes the door at creation. Leave it
# `true` even when the line above is `true` — the belt may be tighter than the
# mechanism and the seed opens the door seconds later; a belt that is LOOSER is
# the bug, and `apps/accounts/tests/test_zitadel_posture.py` pins the direction.
ZITADEL_DISALLOW_PUBLIC_ORG_REGISTRATION=true
# How many consecutive wrong passwords lock an account. **Zero means
# unlimited**, and zero is what the Zitadel image ships. 100 is the ceiling NIST
# SP 800-63B §5.2.2 states ("the verifier SHALL limit consecutive failed
# authentication attempts on a single account to no more than 100"); a product
# tightens it here.
ZITADEL_MAX_PASSWORD_ATTEMPTS=100
# The browser relying party: the OIDC client `manage.py zitadel_seed` makes, as
# an application signs in with it. **Deliberately empty here.** Zitadel shows a
# client secret exactly once, at creation, so the seed command prints both and a
# human copies them in. Empty disables the browser login door entirely rather
# than half-configuring it (config/settings/base.py).
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
#
# **Lost the secret?** It is recoverable, and only this way: Zitadel will not
# show the old one again, so `manage.py zitadel_seed --rotate-web-secret` mints
# a **new** one and prints it once. The client id does not change, so every
# redirect URI you already registered keeps working — which is the whole reason
# rotating beats deleting the application and starting over. The previous secret
# stops working the moment it runs, so run it when you are ready to paste.

# --- The MCP door as an OAuth 2.1 resource server (ADR ident-3, W2-R4) --------
# A third-party client reaches /mcp with an access token Zitadel issued, and
# `apps/accounts/oauth.py` validates it as a resource server: signature against
# the published JWKS, issuer, expiry — and audience.
#
# **ZITADEL_MCP_AUDIENCE EMPTY TURNS THE OAUTH DOOR OFF.** Not "accept any
# audience" — the opposite, and for the same reason GOOGLE_WORKSPACE_DOMAINS
# below works that way: no audience to check against is not a permissive door,
# it is no door, and `oauth.py` refuses accordingly. First-party `ApiToken`
# bearers are unaffected either way.
#
# What to put here: Zitadel puts the **project id** and the API application's
# **client id** in `aud`. Either identifies this resource, so both are accepted
# and you record whichever your tokens actually carry — `manage.py zitadel_seed`
# prints the MCP resource's client id, and the project id is on the project it
# names. Comma-separated; more than one is normal while you migrate.
#
# **`./scripts/setup.sh` fills this in for you**, with the project id the
# seeding step just resolved — so a fresh clone's OAuth door arms itself and
# nobody has to find this line first. It writes it only when the slot is empty:
# a value already here, hand-set or from an externally-managed Zitadel whose
# project this script did not make, is left exactly as it is on every re-run.
ZITADEL_MCP_AUDIENCE=
# How long a fetched JWKS is reused before it is fetched again, in seconds.
#
# **This is the token-revocation latency, and it is a named guess** (the rung's
# recorded blind spot). A JWT is self-contained, so a token revoked at Zitadel
# stays cryptographically valid here until it expires; rotating the *signing
# key* is the only revocation this cache delays, and it delays it by at most
# this many seconds. Five minutes is pyjwt's own default and short enough that a
# key rotation converges inside a deploy window. Introspection would make
# revocation immediate at the cost of a network round trip on every call; that
# trade is not made, and this line is where it would be.
ZITADEL_JWKS_CACHE_SECONDS=300

# --- Workforce sign-in (Google Workspace) ------------------------------------
# The people who build and run this product sign in with Google, restricted to
# the organisation's own domains. Google authenticates them; it grants nothing —
# a fresh workforce login lands with no Membership and, tenancy failing closed,
# sees nothing until somebody invites them.
#
# **GOOGLE_WORKSPACE_DOMAINS EMPTY DISABLES THE PROVIDER.** Not "allow any
# domain" — the opposite. A deployment that set credentials and forgot the
# domain list would otherwise let anybody with a Gmail account create a user
# here, and the failure would look exactly like success. Empty is therefore the
# default, and the button does not appear at all.
#
# Credentials come from a Google Cloud OAuth 2.0 client (Web application), with
# the redirect URI set to <PUBLIC_BASE_URL>/accounts/google/login/callback/.
#
# Since W2-R5 the same credentials are also materialised **inside Zitadel** as an
# org-level Google provider (`manage.py sync_workforce_idp`), so the platform
# login page offers the same button and there is one way identity configuration
# reaches Zitadel (ADR ident-6). The domain restriction stays here and is
# enforced by this product on every assertion: a `hd` hint is a suggestion to
# Google, not a promise to us.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAINS=

# --- Customer SSO -------------------------------------------------------------
# There is deliberately nothing here. A customer's identity provider is an
# `accounts.SsoConnection` row — issuer, client id and client secret encrypted
# with CONNECTIONS_ENCRYPTION_KEY above — created through
# /api/v1/auth/sso-connections/ by an owner or an admin of that tenant. Adding a
# customer's SSO is a row, not a deploy, and their client secret is never in an
# environment file.
#
# SAML is not built. config/settings/base.py, "SAML", carries the reason (a
# libxml2/libxmlsec1 build dependency on every machine that installs this
# template) and the exact steps to turn it on.

# --- Tokens -----------------------------------------------------------------
# How stale ApiToken.last_used_at may get. Every authenticated machine request
# would otherwise write to the token row; 5 minutes answers "is this token still
# in use" just as well, for free.
ACCOUNTS_TOKEN_TOUCH_SECONDS=300
